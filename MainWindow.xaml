<Window
    x:Class="Chlorella.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Chlorella"
    Title="Chlorella">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="RootGrid">
    <Grid.Resources>
        <SolidColorBrush x:Key="MergeAccentBrush" Color="{ThemeResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="SelectionFillBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.2"/>
        <SolidColorBrush x:Key="TableHeaderFillBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.25"/>
        <SolidColorBrush x:Key="TableBodyFillBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.08"/>
        <SolidColorBrush x:Key="TableAlternateFillBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.03"/>
        <Style x:Key="PickerPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"/>
        <Style x:Key="ChromeIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RibbonButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeIconButtonStyle}">
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid>
                    <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Swatch.Opacity" Value="0.7"/></VisualState.Setters></VisualState>
                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Swatch.Opacity" Value="0.5"/></VisualState.Setters></VisualState>
                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Swatch.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                    </VisualStateGroup></VisualStateManager.VisualStateGroups>
                    <Border x:Name="Swatch" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="RibbonToggleStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="34"/><Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="6,3"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="HoverBackground.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="HoverBackground.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.5"/></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="SelectionMark.Opacity" Value="0.35"/></VisualState.Setters></VisualState>
                                    <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="SelectionMark.Opacity" Value="0.35"/><Setter Target="HoverBackground.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/></VisualState.Setters></VisualState>
                                    <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="SelectionMark.Opacity" Value="0.35"/><Setter Target="HoverBackground.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/></VisualState.Setters></VisualState>
                                    <VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="SelectionMark.Opacity" Value="0.35"/><Setter Target="Root.Opacity" Value="0.5"/></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Indeterminate"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid x:Name="Root">
                                <Border x:Name="HoverBackground" Background="{TemplateBinding Background}" CornerRadius="4"/>
                                <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border x:Name="SelectionMark" Background="{ThemeResource SystemControlHighlightAccentBrush}" CornerRadius="4" Opacity="0" IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SheetCellStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{TemplateBinding Background}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,1">
                          <Grid>
                            <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsHitTestVisible="False"/>
                          </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SelectedCellStyle" TargetType="Button" BasedOn="{StaticResource SheetCellStyle}">
            <Setter Property="FocusVisualPrimaryThickness" Value="0"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource SelectionFillBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style x:Key="HeaderCellStyle" TargetType="Button" BasedOn="{StaticResource SheetCellStyle}">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar">
            <TitleBar.LeftHeader>
                <StackPanel Orientation="Horizontal">
                    <SelectorBar x:Name="RibbonSelector" SelectionChanged="RibbonSelector_SelectionChanged">
                        <SelectorBarItem Text="ファイル" Tag="File"/>
                        <SelectorBarItem Text="ホーム" Tag="Home" IsSelected="True"/>
                        <SelectorBarItem Text="挿入" Tag="Insert"/>
                        <SelectorBarItem Text="データ" Tag="Data"/>
                        <SelectorBarItem Text="表示" Tag="View"/>
                        <SelectorBarItem x:Name="ShapeTab" Text="図形" Tag="Shape" Visibility="Collapsed"/>
                    </SelectorBar>
                    <Button x:Name="RibbonToggle" Style="{StaticResource ChromeIconButtonStyle}" Click="RibbonToggle_Click" AutomationProperties.Name="リボンを折りたたむ" ToolTipService.ToolTip="リボンを折りたたむ">
                        <FontIcon x:Name="RibbonToggleIcon" Glyph="&#xE70E;" FontSize="16"/>
                    </Button>
                </StackPanel>
            </TitleBar.LeftHeader>
        </TitleBar>
        <TextBlock x:Name="AccentTextProbe" Visibility="Collapsed" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
        <StackPanel Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <CommandBar x:Name="FileRibbon" HorizontalAlignment="Left" Visibility="Collapsed" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                    <AppBarButton Label="新規" Icon="Add" Click="New_Click"/>
                    <AppBarButton Label="開く" Icon="OpenFile" Click="Open_Click"/>
                    <AppBarButton Label="保存" Icon="Save" Click="Save_Click"/>
                    <AppBarButton Label="名前を付けて保存" Icon="Save" Click="SaveAs_Click"/>
                    <AppBarButton Label="エクスポート" Icon="Share" Click="Export_Click"/>
                    <AppBarButton x:Name="RenameFileButton" Label="名前の変更" Icon="Rename" Click="RenameFile_Click" IsEnabled="False"/>
                    <AppBarButton Label="パスのコピー" Icon="Copy" Click="CopyPath_Click"/>
                </CommandBar>
                <ScrollViewer x:Name="HomeRibbon" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="ホームの操作">
                    <StackPanel Orientation="Horizontal" Padding="8,4" Spacing="8">
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <StackPanel>
                                    <Button Style="{StaticResource RibbonButtonStyle}" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Tag="edit.paste" Click="Clipboard_Click" AutomationProperties.Name="貼り付け" ToolTipService.ToolTip="貼り付け"><FontIcon Glyph="&#xE77F;" FontSize="24"/></Button>
                                    <DropDownButton Style="{StaticResource RibbonButtonStyle}" Height="24" AutomationProperties.Name="貼り付けの種類" ToolTipService.ToolTip="貼り付けの種類">
                                        <DropDownButton.Content><TextBlock Text="貼り付け"/></DropDownButton.Content>
                                        <DropDownButton.Flyout><MenuFlyout>
                                            <MenuFlyoutItem Text="貼り付け" Tag="edit.paste" Click="Clipboard_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="値のみ" Tag="edit.paste.values" Click="Clipboard_Click" />
                                            <MenuFlyoutItem Text="数式のみ" Tag="edit.paste.formulas" Click="Clipboard_Click" />
                                            <MenuFlyoutItem Text="書式のみ" Tag="edit.paste.formats" Click="Clipboard_Click" />
                                        </MenuFlyout></DropDownButton.Flyout>
                                    </DropDownButton>
                                </StackPanel>
                                <StackPanel>
                                    <Button Style="{StaticResource RibbonButtonStyle}" Tag="edit.cut" Click="Clipboard_Click" AutomationProperties.Name="切り取り" ToolTipService.ToolTip="切り取り"><FontIcon Glyph="&#xE8C6;" FontSize="16"/></Button>
                                    <Button Style="{StaticResource RibbonButtonStyle}" Tag="edit.copy" Click="Clipboard_Click" AutomationProperties.Name="コピー" ToolTipService.ToolTip="コピー"><FontIcon Glyph="&#xE8C8;" FontSize="16"/></Button>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="クリップボード" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <ComboBox x:Name="FontNameInput" Width="150" IsEditable="True" PlaceholderText="書体" AutomationProperties.Name="書体" SelectionChanged="FontName_SelectionChanged" TextSubmitted="FontName_TextSubmitted"/>
                                <ComboBox x:Name="FontSizeInput" Width="100" IsEditable="True" PlaceholderText="サイズ" AutomationProperties.Name="フォントサイズ" SelectionChanged="FontSize_SelectionChanged" TextSubmitted="FontSize_TextSubmitted"/>
                                <Button Style="{StaticResource RibbonButtonStyle}" Click="IncreaseFont_Click" AutomationProperties.Name="文字を大きく" ToolTipService.ToolTip="文字を大きく"><FontIcon Glyph="&#xE8E8;" FontSize="16"/></Button>
                                <Button Style="{StaticResource RibbonButtonStyle}" Click="DecreaseFont_Click" AutomationProperties.Name="文字を小さく" ToolTipService.ToolTip="文字を小さく"><FontIcon Glyph="&#xE8E7;" FontSize="16"/></Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton x:Name="BoldButton" Style="{StaticResource RibbonToggleStyle}" Tag="home.bold" Click="Format_Click" AutomationProperties.Name="太字" ToolTipService.ToolTip="太字"><FontIcon Glyph="&#xE8DD;" FontSize="16"/></ToggleButton>
                                <ToggleButton x:Name="ItalicButton" Style="{StaticResource RibbonToggleStyle}" Tag="home.italic" Click="Format_Click" AutomationProperties.Name="斜体" ToolTipService.ToolTip="斜体"><FontIcon Glyph="&#xE8DB;" FontSize="16"/></ToggleButton>
                                <ToggleButton x:Name="UnderlineButton" Style="{StaticResource RibbonToggleStyle}" Tag="home.underline" Click="Format_Click" AutomationProperties.Name="下線" ToolTipService.ToolTip="下線"><FontIcon Glyph="&#xE8DC;" FontSize="16"/></ToggleButton>
                                <Button Style="{StaticResource RibbonButtonStyle}" Tag="fill" Click="ColorApply_Click" AutomationProperties.Name="セルの塗りつぶし" ToolTipService.ToolTip="セルの塗りつぶし"><Grid Width="20" Height="20"><FontIcon Glyph="&#xE790;" FontSize="16"/><Rectangle x:Name="FillColorSwatch" Height="3" VerticalAlignment="Bottom" Fill="#FFFF00"/></Grid></Button>
                                <Button Style="{StaticResource RibbonButtonStyle}" Tag="fill" Click="ColorPalette_Click" AutomationProperties.Name="塗りつぶしの色を選択" ToolTipService.ToolTip="塗りつぶしの色を選択"><FontIcon Glyph="&#xE70D;" FontSize="10"/></Button>
                                <Button Style="{StaticResource RibbonButtonStyle}" Tag="font" Click="ColorApply_Click" AutomationProperties.Name="文字の色" ToolTipService.ToolTip="文字の色"><Grid Width="20" Height="20"><FontIcon Glyph="&#xE8D2;" FontSize="16"/><Rectangle x:Name="FontColorSwatch" Height="3" VerticalAlignment="Bottom" Fill="#FF0000"/></Grid></Button>
                                <Button Style="{StaticResource RibbonButtonStyle}" Tag="font" Click="ColorPalette_Click" AutomationProperties.Name="文字の色を選択" ToolTipService.ToolTip="文字の色を選択"><FontIcon Glyph="&#xE70D;" FontSize="10"/></Button>
                                <Button Style="{StaticResource RibbonButtonStyle}" Click="Undo_Click" AutomationProperties.Name="元に戻す" ToolTipService.ToolTip="元に戻す"><FontIcon Glyph="&#xE7A7;" FontSize="16"/></Button>
                                <Button Style="{StaticResource RibbonButtonStyle}" Click="Redo_Click" AutomationProperties.Name="やり直し" ToolTipService.ToolTip="やり直し"><FontIcon Glyph="&#xE7A6;" FontSize="16"/></Button>
                            </StackPanel>
                            <TextBlock Text="フォント" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton x:Name="AlignTopButton" Style="{StaticResource RibbonToggleStyle}" Tag="home.alignTop" Click="Format_Click" AutomationProperties.Name="上揃え" ToolTipService.ToolTip="上揃え"><Border Width="18" Height="18" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1" CornerRadius="2" Padding="3"><StackPanel VerticalAlignment="Top" Spacing="2"><Rectangle Height="1" Width="10" Fill="{ThemeResource TextFillColorPrimaryBrush}"/><Rectangle Height="1" Width="7" HorizontalAlignment="Left" Fill="{ThemeResource SystemControlHighlightAccentBrush}"/></StackPanel></Border></ToggleButton>
                                <ToggleButton x:Name="AlignMiddleButton" Style="{StaticResource RibbonToggleStyle}" Tag="home.alignMiddle" Click="Format_Click" AutomationProperties.Name="上下中央揃え" ToolTipService.ToolTip="上下中央揃え"><Border Width="18" Height="18" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1" CornerRadius="2" Padding="3"><StackPanel VerticalAlignment="Center" Spacing="2"><Rectangle Height="1" Width="10" Fill="{ThemeResource TextFillColorPrimaryBrush}"/><Rectangle Height="1" Width="7" HorizontalAlignment="Left" Fill="{ThemeResource SystemControlHighlightAccentBrush}"/></StackPanel></Border></ToggleButton>
                                <ToggleButton x:Name="AlignBottomButton" Style="{StaticResource RibbonToggleStyle}" Tag="home.alignBottom" Click="Format_Click" AutomationProperties.Name="下揃え" ToolTipService.ToolTip="下揃え"><Border Width="18" Height="18" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1" CornerRadius="2" Padding="3"><StackPanel VerticalAlignment="Bottom" Spacing="2"><Rectangle Height="1" Width="10" Fill="{ThemeResource TextFillColorPrimaryBrush}"/><Rectangle Height="1" Width="7" HorizontalAlignment="Left" Fill="{ThemeResource SystemControlHighlightAccentBrush}"/></StackPanel></Border></ToggleButton>
                                <ToggleButton x:Name="WrapButton" Style="{StaticResource RibbonToggleStyle}" Tag="home.wrapText" Click="Format_Click" AutomationProperties.Name="文字列を折り返す" ToolTipService.ToolTip="文字列を折り返す"><Grid Width="20" Height="20"><FontIcon Glyph="&#xE8E4;" FontSize="16"/><FontIcon Glyph="&#x21B5;" FontFamily="Segoe UI" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid></ToggleButton>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton x:Name="AlignLeftButton" Style="{StaticResource RibbonToggleStyle}" Tag="home.alignLeft" Click="Format_Click" AutomationProperties.Name="左揃え" ToolTipService.ToolTip="左揃え"><FontIcon Glyph="&#xE8E4;" FontSize="16"/></ToggleButton>
                                <ToggleButton x:Name="AlignCenterButton" Style="{StaticResource RibbonToggleStyle}" Tag="home.alignCenter" Click="Format_Click" AutomationProperties.Name="中央揃え" ToolTipService.ToolTip="中央揃え"><FontIcon Glyph="&#xE8E3;" FontSize="16"/></ToggleButton>
                                <ToggleButton x:Name="AlignRightButton" Style="{StaticResource RibbonToggleStyle}" Tag="home.alignRight" Click="Format_Click" AutomationProperties.Name="右揃え" ToolTipService.ToolTip="右揃え"><FontIcon Glyph="&#xE8E2;" FontSize="16"/></ToggleButton>
                                <Button Style="{StaticResource RibbonButtonStyle}" Tag="home.decreaseIndent" Click="Format_Click" AutomationProperties.Name="インデントを減らす" ToolTipService.ToolTip="インデントを減らす"><Grid Width="20" Height="20"><FontIcon Glyph="&#xE8E4;" FontSize="16"/><FontIcon Glyph="&#xE76B;" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid></Button>
                                <Button Style="{StaticResource RibbonButtonStyle}" Tag="home.increaseIndent" Click="Format_Click" AutomationProperties.Name="インデントを増やす" ToolTipService.ToolTip="インデントを増やす"><Grid Width="20" Height="20"><FontIcon Glyph="&#xE8E4;" FontSize="16"/><FontIcon Glyph="&#xE76C;" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid></Button>
                                <ToggleButton x:Name="MergeButton" Style="{StaticResource RibbonToggleStyle}" Click="Merge_Click" AutomationProperties.Name="セルの結合" ToolTipService.ToolTip="セルの結合・解除"><Border Width="20" Height="16" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1" CornerRadius="2"><TextBlock Text="↔" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ToggleButton>
                            </StackPanel>
                            <TextBlock Text="配置" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
                        <StackPanel Spacing="3">
                            <ComboBox x:Name="NumberFormatInput" Width="160" PlaceholderText="表示形式" AutomationProperties.Name="表示形式" SelectionChanged="NumberFormat_SelectionChanged">
                                <ComboBoxItem Content="標準" Tag="General"/><ComboBoxItem Content="数値" Tag="Number"/><ComboBoxItem Content="通貨" Tag="Currency"/><ComboBoxItem Content="日付" Tag="Short Date"/><ComboBoxItem Content="時刻" Tag="Time"/><ComboBoxItem Content="パーセント" Tag="Percentage"/><ComboBoxItem Content="文字列" Tag="Text"/>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Style="{StaticResource RibbonButtonStyle}" Tag="home.percent" Click="Format_Click" AutomationProperties.Name="パーセント表示" ToolTipService.ToolTip="パーセント表示"><FontIcon Glyph="&#x0025;" FontFamily="Segoe UI" FontSize="16"/></Button>
                                <Button Style="{StaticResource RibbonButtonStyle}" Tag="home.comma" Click="Format_Click" AutomationProperties.Name="桁区切り" ToolTipService.ToolTip="桁区切り"><FontIcon Glyph="&#x002C;" FontFamily="Segoe UI" FontSize="16"/></Button>
                                <Button Style="{StaticResource RibbonButtonStyle}" Tag="home.increaseDecimal" Click="Format_Click" AutomationProperties.Name="小数点以下の桁を増やす" ToolTipService.ToolTip="小数点以下の桁を増やす"><StackPanel Orientation="Horizontal" Spacing="1"><FontIcon Glyph="&#xE710;" FontSize="12"/><TextBlock Text=".0" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource RibbonButtonStyle}" Tag="home.decreaseDecimal" Click="Format_Click" AutomationProperties.Name="小数点以下の桁を減らす" ToolTipService.ToolTip="小数点以下の桁を減らす"><StackPanel Orientation="Horizontal" Spacing="1"><FontIcon Glyph="&#xE738;" FontSize="12"/><TextBlock Text=".0" VerticalAlignment="Center"/></StackPanel></Button>
                            </StackPanel>
                            <TextBlock Text="数値" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <CommandBar x:Name="InsertRibbon" HorizontalAlignment="Left" Visibility="Collapsed" DefaultLabelPosition="Bottom" IsDynamicOverflowEnabled="True">
                    <AppBarButton Label="テーブル" Click="InsertTable_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE8A9;"/></AppBarButton.Icon></AppBarButton>
                    <AppBarSeparator/>
                    <AppBarButton Label="画像" Click="InsertPicture_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE8B9;"/></AppBarButton.Icon></AppBarButton>
                    <AppBarButton Label="図形" Tag="insert" Click="ShapeGallery_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE8B3;"/></AppBarButton.Icon></AppBarButton>
                </CommandBar>
                <CommandBar x:Name="ViewRibbon" HorizontalAlignment="Left" Visibility="Collapsed" DefaultLabelPosition="Right">
                    <AppBarButton Label="前の行" Icon="Up" Click="Previous_Click"/>
                    <AppBarButton Label="次の行" Click="Next_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE74B;"/></AppBarButton.Icon></AppBarButton>
                </CommandBar>
                <CommandBar x:Name="DataRibbon" HorizontalAlignment="Left" Visibility="Collapsed" DefaultLabelPosition="Bottom">
                    <AppBarButton Label="フラッシュ フィル" Click="FlashFill_Click" ToolTipService.ToolTip="フラッシュ フィル (Ctrl+E)"><AppBarButton.Icon><FontIcon Glyph="&#xE8C6;"/></AppBarButton.Icon></AppBarButton>
                </CommandBar>
                <CommandBar x:Name="ShapeRibbon" HorizontalAlignment="Left" Visibility="Collapsed" DefaultLabelPosition="Bottom">
                    <AppBarButton Label="図形の変更" Tag="change" Click="ShapeGallery_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE8B3;"/></AppBarButton.Icon></AppBarButton>
                    <AppBarButton Label="塗りつぶし" Tag="shapeFill" Click="ColorPalette_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE790;"/></AppBarButton.Icon></AppBarButton>
                    <AppBarButton Label="輪郭" Tag="shapeLine" Click="ColorPalette_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE70F;"/></AppBarButton.Icon></AppBarButton>
                </CommandBar>
            </Grid>
        </StackPanel>
        <Grid Grid.Row="2" Padding="8,4" ColumnSpacing="6" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="AddressInput" Text="A1" AutomationProperties.Name="名前ボックス" KeyDown="AddressInput_KeyDown" LostFocus="AddressInput_LostFocus"/>
            <TextBlock Grid.Column="1" Text="fx" FontStyle="Italic" VerticalAlignment="Center"/>
            <local:FormulaTextBox x:Name="FormulaInput" Grid.Column="2" AutomationProperties.Name="数式バー" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140" MinHeight="32" TextChanged="FormulaInput_TextChanged"/>
            <Button x:Name="FormulaToggle" Grid.Column="3" Style="{StaticResource ChromeIconButtonStyle}" Click="FormulaToggle_Click" AutomationProperties.Name="数式バーを展開" ToolTipService.ToolTip="数式バーを展開">
                <FontIcon x:Name="FormulaToggleIcon" Glyph="&#xE70D;" FontSize="16"/>
            </Button>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ScrollViewer x:Name="GridScroll" ZoomMode="Enabled" MinZoomFactor="0.5" MaxZoomFactor="2" HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" PointerWheelChanged="GridScroll_PointerWheelChanged">
                <Grid x:Name="CellGrid" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid.RenderTransform><TranslateTransform x:Name="CellGridOffset"/></Grid.RenderTransform>
                </Grid>
            </ScrollViewer>
            <ScrollBar x:Name="RowScroll" IndicatorMode="MouseIndicator" Grid.Column="1" Width="18" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{ThemeResource LayerFillColorDefaultBrush}" Orientation="Vertical" Minimum="1" Maximum="100" SmallChange="1" LargeChange="40" Value="1" ValueChanged="RowScroll_ValueChanged" AutomationProperties.Name="行をスクロール"/>
            <ScrollBar x:Name="ColumnScroll" IndicatorMode="MouseIndicator" Grid.Row="1" Height="18" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{ThemeResource LayerFillColorDefaultBrush}" Orientation="Horizontal" Minimum="0" Maximum="26" SmallChange="0.1" LargeChange="24" ValueChanged="ColumnScroll_ValueChanged" AutomationProperties.Name="列をスクロール"/>
        </Grid>
        <Border Grid.Row="4" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="6,0">
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Visible" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="シートタブをスクロール">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <SelectorBar x:Name="SheetTabs" Height="32" SelectionChanged="SheetTabs_SelectionChanged"/>
                    <Button Style="{StaticResource ChromeIconButtonStyle}" Click="AddSheet_Click" AutomationProperties.Name="シートを追加" ToolTipService.ToolTip="シートを追加">
                        <FontIcon Glyph="&#xE710;" FontSize="16"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Grid.Row="5" MinHeight="28" Padding="12,5" BorderThickness="0,1,0,0"
                Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    <Button Style="{StaticResource ChromeIconButtonStyle}" Click="ZoomOut_Click" AutomationProperties.Name="縮小" ToolTipService.ToolTip="縮小"><FontIcon Glyph="&#xE738;" FontSize="12"/></Button>
                    <Slider x:Name="ZoomSlider" Width="120" Minimum="50" Maximum="200" Value="100" StepFrequency="10" SmallChange="10" LargeChange="25" ValueChanged="ZoomSlider_ValueChanged" AutomationProperties.Name="表示倍率"/>
                    <Button Style="{StaticResource ChromeIconButtonStyle}" Click="ZoomIn_Click" AutomationProperties.Name="拡大" ToolTipService.ToolTip="拡大"><FontIcon Glyph="&#xE710;" FontSize="12"/></Button>
                    <Button x:Name="ZoomReset" Style="{StaticResource ChromeIconButtonStyle}" Content="100%" Click="ZoomReset_Click" AutomationProperties.Name="表示倍率を 100% に戻す" ToolTipService.ToolTip="表示倍率を 100% に戻す"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
